rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return hasRole('staff') || isAdmin();
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 5 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['guest', 'staff', 'admin'] &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn(); // Users can view profiles to identify staff/guests
      allow list: if isAdmin();    // Only admin can list all users for auditing
      
      allow create: if isSignedIn() && 
                    userId == request.auth.uid && 
                    isValidUser(incoming()) && 
                    incoming().role == 'guest'; // New users default to guest via client
                    
      allow update: if isSignedIn() && (
        // Admin can update anything (e.g. promoting staff)
        isAdmin() || 
        // User can only update their own non-role fields
        (userId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar']) &&
         incoming().name is string && incoming().name.size() <= 100)
      );
    }

    // --- Incident Validation ---
    function isValidIncident(data) {
      return data.keys().hasAll(['type', 'status', 'userId', 'createdAt']) &&
             data.type in ['medical', 'fire', 'security', 'other'] &&
             data.status in ['active', 'responding', 'resolved'] &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time &&
             (data.get('description', '') is string && data.get('description', '').size() <= 500);
    }

    match /incidents/{incidentId} {
      // Identity Protection: Valid Id
      allow get: if isSignedIn() && (
        isStaff() || 
        existing().userId == request.auth.uid
      );
      
      // Query Enforcer
      allow list: if isSignedIn() && (
        isStaff() || 
        resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() && 
                    isEmailVerified() && 
                    isValidId(incidentId) && 
                    isValidIncident(incoming());

      allow update: if isSignedIn() && (
        // Admin master override
        isAdmin() ||
        (
          // Staff taking responding role
          (isStaff() && 
           existing().status == 'active' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'responderId']) &&
           incoming().status == 'responding' &&
           incoming().responderId == request.auth.uid) ||
           
          // Staff resolving
          (isStaff() && 
           existing().status == 'responding' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedAt']) &&
           incoming().status == 'resolved' &&
           incoming().resolvedAt == request.time) ||
           
          // Guest updating description of an active incident
          (existing().userId == request.auth.uid &&
           existing().status == 'active' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['description']))
        )
      );
      
      // Messages sub-collection
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.keys().hasAll(['senderId', 'text', 'type', 'createdAt']) &&
                 data.senderId == request.auth.uid &&
                 data.text is string && data.text.size() <= 1000 &&
                 data.type in ['text', 'announcement'] &&
                 data.createdAt == request.time;
        }

        // Only participants (reporter or anyone if staff) can read/write messages
        allow read: if isSignedIn() && (
          isStaff() || 
          get(/databases/$(database)/documents/incidents/$(incidentId)).data.userId == request.auth.uid
        );

        allow create: if isSignedIn() && 
                      isValidId(messageId) && 
                      isValidMessage(incoming());
      }
    }

    // --- Venues (Management & Consumption) ---
    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Global Announcements ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
